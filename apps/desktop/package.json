{
  "name": "@pigcode/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Pigcode desktop",
  "author": "Pigcode",
  "homepage": "https://github.com/pigcode/pigcode",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "build:host": "node ../../scripts/build-host.ts",
    "notices": "node ../../scripts/notices.ts",
    "package:mac": "pnpm notices && pnpm build:host && pnpm build && electron-builder --mac --arm64 --publish never",
    "package:mac:x64": "pnpm notices && pnpm build:host && pnpm build && electron-builder --mac --x64 --publish never",
    "package:mac:all": "pnpm notices && pnpm build:host && pnpm build && electron-builder --mac --arm64 --x64 --publish never",
    "package:win": "pnpm notices && pnpm build:host && pnpm build && electron-builder --win --publish never",
    "package:linux": "pnpm notices && pnpm build:host && pnpm build && electron-builder --linux --publish never",
    "test:packaged": "playwright test e2e/packaged.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@pigcode/client-runtime": "workspace:*",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "@pigcode/ui-chat": "workspace:*",
    "@pigcode/ui-composer": "workspace:*",
    "@pigcode/ui-plugin-manager": "workspace:*",
    "@pigcode/ui-primitives": "workspace:*",
    "@pigcode/ui-settings": "workspace:*",
    "@pigcode/ui-shell": "workspace:*",
    "@pigcode/ui-workbench": "workspace:*",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.11",
    "lucide-react": "1.0.1",
    "node-pty": "1.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "43.4.1",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.16"
  }
}
