{
  "name": "pigcode-frontend",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:host": "node scripts/build-host.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "real:claude": "node scripts/real-smoke.ts claude",
    "real:codex": "node scripts/real-smoke.ts codex",
    "real:codex:multi": "node scripts/real-smoke.ts codex-multi",
    "create-plugin": "node scripts/create-plugin.ts",
    "gen:ultracode": "pnpm --filter @pigcode/agent-claude gen:ultracode",
    "postinstall": "node scripts/fix-node-pty-helper.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-react": "5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
