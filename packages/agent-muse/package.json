{
  "name": "@pigcode/agent-muse",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Muse Code",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:muse"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "muse",
        "featured": true,
        "homepage": "https://meta-models.github.io/muse-code-sdk/",
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "label": {
              "zh-CN": "程序位置",
              "en-US": "Program path"
            },
            "pathKind": "file",
            "placeholder": "muse"
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            }
          }
        ],
        "requiresInstance": true
      }
    }
  },
  "dependencies": {
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "@muse-code/sdk": "1.4.6",
    "@pigcode/native-agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
