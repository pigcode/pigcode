{
  "name": "@pigcode/agent-kiro",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "description": "Kiro CLI integration for Pigcode",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Kiro",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:kiro"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "kiro",
        "requiresInstance": true,
        "featured": false,
        "homepage": "https://kiro.dev/cli/",
        "description": {
          "zh-CN": "用电脑上的 Kiro",
          "en-US": "Use Kiro on this computer"
        },
        "installHint": {
          "zh-CN": "先装好 kiro-cli，再在终端里登录",
          "en-US": "Install kiro-cli, then sign in from the terminal"
        },
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "程序位置",
              "en-US": "Program path"
            },
            "placeholder": "kiro-cli"
          },
          {
            "key": "apiKey",
            "type": "secret",
            "visibility": "settings",
            "label": {
              "zh-CN": "Kiro API 密钥",
              "en-US": "Kiro API key"
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            }
          }
        ],
        "acpRegistryAgentIds": [
          "kiro"
        ]
      }
    }
  },
  "dependencies": {
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "@pigcode/acp-runtime": "workspace:*"
  }
}
