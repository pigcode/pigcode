{
  "name": "@pigcode/agent-cursor",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Cursor",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:cursor"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "cursor",
        "featured": true,
        "acpRegistryAgentIds": [
          "cursor"
        ],
        "homepage": "https://cursor.com/docs/sdk",
        "settings": [
          {
            "key": "apiKey",
            "type": "secret",
            "label": {
              "zh-CN": "Cursor API 密钥",
              "en-US": "Cursor API key"
            },
            "visibility": "settings"
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            }
          }
        ],
        "requiresInstance": true
      }
    }
  },
  "dependencies": {
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "@cursor/sdk": "1.3.1",
    "@pigcode/native-agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
