{
  "name": "@pigcode/agent-acp",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@types/yauzl": "3.4.0"
  },
  "description": "Configurable Agent Client Protocol connections for Pigcode",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "ACP",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:acp"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "acp",
        "acpRegistry": true,
        "homepage": "https://agentclientprotocol.com/",
        "description": {
          "zh-CN": "接入本机命令或 ACP Registry 中的 Agent。",
          "en-US": "Connect a local ACP command or an agent from the ACP Registry."
        },
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "可执行文件",
              "en-US": "Executable"
            },
            "description": {
              "zh-CN": "填写命令名或绝对路径。Registry 实例留空使用托管运行时。",
              "en-US": "Enter a command or an absolute path. Leave blank for a managed Registry runtime."
            }
          },
          {
            "key": "arguments",
            "type": "arguments",
            "label": {
              "zh-CN": "启动参数",
              "en-US": "Arguments"
            },
            "description": {
              "zh-CN": "每行一个参数，保留参数中的空格。",
              "en-US": "Enter one literal argument per line. Spaces within an argument are preserved."
            }
          },
          {
            "key": "registryId",
            "type": "text",
            "label": {
              "zh-CN": "ACP Registry ID",
              "en-US": "ACP Registry ID"
            },
            "description": {
              "zh-CN": "目录实例的标识。本地命令留空。",
              "en-US": "Registry identifier. Leave blank for a local command."
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "@pigcode/acp-runtime": "workspace:*",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "tar": "7.5.22",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  }
}
