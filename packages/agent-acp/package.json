{
  "name": "@pigcode/agent-acp",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "description": "Configurable Agent Client Protocol connections for Pigcode",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "ACP",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:acp"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "acp",
        "acpRegistry": true,
        "homepage": "https://agentclientprotocol.com/",
        "description": {
          "zh-CN": "接入电脑上的命令，或 ACP Registry 里的 Agent",
          "en-US": "Connect a command on this computer or an agent from the ACP Registry"
        },
        "settings": [
          {
            "key": "registryId",
            "type": "text",
            "label": {
              "zh-CN": "ACP Registry ID",
              "en-US": "ACP Registry ID"
            },
            "description": {
              "zh-CN": "Registry 里的 ID。用电脑上的命令时不填",
              "en-US": "The ID in the Registry. Leave empty for a local command"
            }
          },
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "程序位置",
              "en-US": "Program path"
            },
            "description": {
              "zh-CN": "填命令名或完整路径。用 Registry 的 Agent 不用填。",
              "en-US": "A command name or full path. Leave empty for Registry agents."
            }
          },
          {
            "key": "authMethodId",
            "type": "text",
            "label": {
              "zh-CN": "登录方式 ID（可以不填）",
              "en-US": "Sign-in method ID (optional)"
            }
          },
          {
            "key": "arguments",
            "type": "arguments",
            "label": {
              "zh-CN": "启动参数",
              "en-US": "Arguments"
            },
            "description": {
              "zh-CN": "每行一个参数，空格会保留",
              "en-US": "One argument per line. Spaces are kept."
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "@pigcode/acp-runtime": "workspace:*",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "zod": "4.4.3"
  }
}
