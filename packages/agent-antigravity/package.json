{
  "name": "@pigcode/agent-antigravity",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Antigravity CLI agent for Pigcode",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Antigravity",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:antigravity"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "antigravity",
        "featured": true,
        "acpRegistryAgentIds": [
          "antigravity-acp"
        ],
        "description": {
          "zh-CN": "Google Antigravity CLI，支持通过 ACP 使用独立的 Google 账号和原生会话。",
          "en-US": "Google Antigravity CLI over ACP, with per-instance Google sign-in and native sessions."
        },
        "homepage": "https://antigravity.google/docs/cli/acp",
        "settings": [
          {
            "key": "authMethod",
            "type": "select",
            "default": "oauth-personal",
            "label": {
              "zh-CN": "登录方式",
              "en-US": "Sign-in method"
            },
            "options": [
              {
                "value": "oauth-personal",
                "label": {
                  "zh-CN": "个人 Google 账号",
                  "en-US": "Google account"
                }
              },
              {
                "value": "oauth-business",
                "label": {
                  "zh-CN": "Gemini Enterprise",
                  "en-US": "Gemini Enterprise"
                }
              },
              {
                "value": "gemini-api-key",
                "label": {
                  "zh-CN": "Gemini API key",
                  "en-US": "Gemini API key"
                }
              },
              {
                "value": "agent-platform",
                "label": {
                  "zh-CN": "Agent Platform（Vertex AI）",
                  "en-US": "Agent Platform (Vertex AI)"
                }
              }
            ]
          },
          {
            "key": "apiKey",
            "type": "secret",
            "label": {
              "zh-CN": "API 密钥",
              "en-US": "API key"
            },
            "description": {
              "zh-CN": "用于 Gemini API 或 Vertex AI Express，由 Host 单独保存。",
              "en-US": "Gemini or Vertex AI express key. Stored separately on the host."
            }
          },
          {
            "key": "gcpProject",
            "type": "text",
            "label": {
              "zh-CN": "GCP 项目",
              "en-US": "GCP project"
            },
            "placeholder": "my-project-id",
            "description": {
              "zh-CN": "Gemini Enterprise 需要项目和区域。Vertex AI 也可使用 API 密钥。",
              "en-US": "Gemini Enterprise needs a project and location. Vertex AI can also use an API key."
            }
          },
          {
            "key": "gcpLocation",
            "type": "text",
            "label": {
              "zh-CN": "GCP 区域",
              "en-US": "GCP location"
            },
            "placeholder": "us-central1"
          },
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "可执行文件",
              "en-US": "Binary path"
            },
            "placeholder": "agy",
            "description": {
              "zh-CN": "留空使用托管安装，或查找 PATH 中的 agy。",
              "en-US": "Leave blank to use the managed installation or find agy on PATH."
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            },
            "description": {
              "zh-CN": "为这个实例设置代理等运行环境。",
              "en-US": "Configure the running environment for this instance, such as a proxy."
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "@pigcode/acp-runtime": "workspace:*",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
