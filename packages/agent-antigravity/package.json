{
  "name": "@pigcode/agent-antigravity",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Antigravity CLI agent for Pigcode",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Antigravity",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:antigravity"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "antigravity",
        "featured": true,
        "acpRegistryAgentIds": [
          "antigravity-acp"
        ],
        "description": {
          "zh-CN": "Google 的编程 Agent，每个都能登录自己的 Google 账号",
          "en-US": "Google's coding agent. Each one can sign in to its own Google account"
        },
        "homepage": "https://antigravity.google/docs/cli/acp",
        "settings": [
          {
            "key": "authMethod",
            "type": "select",
            "default": "oauth-personal",
            "label": {
              "zh-CN": "登录方式",
              "en-US": "Sign-in method"
            },
            "options": [
              {
                "value": "oauth-personal",
                "label": {
                  "zh-CN": "个人 Google 账号",
                  "en-US": "Google account"
                }
              },
              {
                "value": "oauth-business",
                "label": {
                  "zh-CN": "Gemini Enterprise",
                  "en-US": "Gemini Enterprise"
                }
              },
              {
                "value": "gemini-api-key",
                "label": {
                  "zh-CN": "Gemini API key",
                  "en-US": "Gemini API key"
                }
              },
              {
                "value": "agent-platform",
                "label": {
                  "zh-CN": "Agent Platform（Vertex AI）",
                  "en-US": "Agent Platform (Vertex AI)"
                }
              }
            ]
          },
          {
            "key": "apiKey",
            "type": "secret",
            "label": {
              "zh-CN": "API 密钥",
              "en-US": "API key"
            },
            "description": {
              "zh-CN": "Gemini API 或 Vertex AI Express 用的密钥，单独加密保存",
              "en-US": "Key for the Gemini API or Vertex AI Express, stored on its own"
            }
          },
          {
            "key": "gcpProject",
            "type": "text",
            "label": {
              "zh-CN": "GCP 项目",
              "en-US": "GCP project"
            },
            "placeholder": "my-project-id",
            "description": {
              "zh-CN": "Gemini Enterprise 要填项目和区域。Vertex AI 也可以用 API 密钥。",
              "en-US": "Gemini Enterprise needs a project and location. Vertex AI can also use an API key."
            }
          },
          {
            "key": "gcpLocation",
            "type": "text",
            "label": {
              "zh-CN": "GCP 区域",
              "en-US": "GCP location"
            },
            "placeholder": "us-central1"
          },
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "程序位置",
              "en-US": "Program path"
            },
            "placeholder": "agy",
            "description": {
              "zh-CN": "不填就用 Pigcode 装的版本，或者自动找 agy",
              "en-US": "Leave empty to use the copy Pigcode installed, or find agy automatically"
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            },
            "description": {
              "zh-CN": "给这个 Agent 设置代理等环境",
              "en-US": "Set things like a proxy for this agent"
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "@pigcode/acp-runtime": "workspace:*",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
