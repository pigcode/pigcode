{
  "name": "@pigcode/agent-claude",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Claude Code agent for Pigcode",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:ultracode": "node scripts/gen-ultracode.ts"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Claude Code",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:claude"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace"
    ],
    "contributes": {
      "agent": {
        "id": "claude",
        "featured": true,
        "acpRegistryAgentIds": [
          "claude-acp"
        ],
        "description": {
          "zh-CN": "Anthropic 的编程 Agent，能写计划、派子 Agent、用 MCP 工具",
          "en-US": "Anthropic's coding agent. It can plan, send subagents and use MCP tools"
        },
        "homepage": "https://claude.com/product/claude-code",
        "installHint": {
          "zh-CN": "先安装 Claude Code（npm i -g @anthropic-ai/claude-code），再运行 claude auth login 登录",
          "en-US": "Install Claude Code (npm i -g @anthropic-ai/claude-code), then run claude auth login"
        },
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "程序位置",
              "en-US": "Program path"
            },
            "placeholder": "claude",
            "description": {
              "zh-CN": "不填就自动找 claude",
              "en-US": "Leave empty to find claude automatically"
            }
          },
          {
            "key": "configDir",
            "type": "path",
            "pathKind": "directory",
            "label": {
              "zh-CN": "配置文件夹",
              "en-US": "Config folder"
            },
            "placeholder": "~/.claude",
            "description": {
              "zh-CN": "Claude Code 放设置和登录信息的地方（CLAUDE_CONFIG_DIR）。不填就用默认位置。",
              "en-US": "Where Claude Code keeps its settings and sign-in (CLAUDE_CONFIG_DIR). Leave empty for the default."
            }
          },
          {
            "key": "autoCompactWindow",
            "type": "text",
            "label": {
              "zh-CN": "聊到多长时压缩",
              "en-US": "Compact after"
            },
            "description": {
              "zh-CN": "填 100,000 到 1,000,000（按 token 算），不填用 Claude 的默认值",
              "en-US": "Enter 100,000 to 1,000,000 tokens, or leave empty for Claude's default"
            },
            "integerRange": {
              "min": 100000,
              "max": 1000000
            },
            "placeholder": "300000"
          },
          {
            "key": "idleCompaction",
            "type": "select",
            "label": {
              "zh-CN": "空闲时压缩",
              "en-US": "Compact idle threads"
            },
            "description": {
              "zh-CN": "会话超过 200,000 token 后，空闲时怎么压缩",
              "en-US": "What to do with idle threads over 200,000 tokens"
            },
            "options": [
              {
                "value": "default",
                "label": {
                  "zh-CN": "Claude 的默认",
                  "en-US": "Claude's default"
                }
              },
              {
                "value": "onReturn",
                "label": {
                  "zh-CN": "回来时问我",
                  "en-US": "Ask when I come back"
                }
              },
              {
                "value": "beforeCacheExpires",
                "label": {
                  "zh-CN": "过期前自动压缩",
                  "en-US": "Before the cache expires"
                }
              },
              {
                "value": "off",
                "label": {
                  "zh-CN": "不压缩",
                  "en-US": "Never"
                }
              }
            ],
            "default": "default"
          },
          {
            "key": "launchArgs",
            "type": "text",
            "monospace": true,
            "label": {
              "zh-CN": "启动参数",
              "en-US": "Launch arguments"
            },
            "placeholder": "--chrome",
            "description": {
              "zh-CN": "加给 Claude Code 的额外参数。权限相关的参数由 Pigcode 的权限设置管。",
              "en-US": "Extra flags for Claude Code. Permission flags follow Pigcode's permission setting."
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            },
            "description": {
              "zh-CN": "启动 Claude Code 时加的环境变量，比如代理或 API 地址",
              "en-US": "Extra environment variables for Claude Code, like a proxy or API address"
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "json5": "2.2.3",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
