{
  "name": "@pigcode/agent-claude",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Claude Code agent for Pigcode",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:ultracode": "node scripts/gen-ultracode.ts"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Claude Code",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:claude"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace"
    ],
    "contributes": {
      "agent": {
        "id": "claude",
        "featured": true,
        "acpRegistryAgentIds": [
          "claude-acp"
        ],
        "description": {
          "zh-CN": "Anthropic 的 Claude Code CLI：审批、提问、计划模式、子代理与 MCP 工具。",
          "en-US": "Anthropic's Claude Code CLI with approvals, questions, plan mode, sub-agents and MCP tools."
        },
        "homepage": "https://claude.com/product/claude-code",
        "installHint": {
          "zh-CN": "安装 Claude Code（npm i -g @anthropic-ai/claude-code），然后运行 claude auth login 登录。",
          "en-US": "Install Claude Code (npm i -g @anthropic-ai/claude-code), then run claude auth login."
        },
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "可执行文件",
              "en-US": "Binary path"
            },
            "placeholder": "claude",
            "description": {
              "zh-CN": "留空时在 PATH 与常见安装目录中查找 claude。",
              "en-US": "Leave blank to look up claude on PATH and in common install locations."
            }
          },
          {
            "key": "configDir",
            "type": "path",
            "pathKind": "directory",
            "label": "CLAUDE_CONFIG_DIR",
            "placeholder": "~/.claude",
            "description": {
              "zh-CN": "Claude Code 读取配置与登录信息的目录；留空使用默认位置。",
              "en-US": "Where Claude Code keeps its settings and credentials; blank uses the default."
            }
          },
          {
            "key": "autoCompactWindow",
            "type": "text",
            "label": {
              "zh-CN": "自动压缩阈值",
              "en-US": "Auto-compact after"
            },
            "description": {
              "zh-CN": "输入 100,000 至 1,000,000 个 token，留空使用 Claude 的默认值。",
              "en-US": "Enter 100,000 to 1,000,000 tokens, or leave blank to use Claude’s default."
            },
            "integerRange": {
              "min": 100000,
              "max": 1000000
            },
            "placeholder": "300000"
          },
          {
            "key": "idleCompaction",
            "type": "select",
            "label": {
              "zh-CN": "空闲会话压缩",
              "en-US": "Compact idle threads"
            },
            "description": {
              "zh-CN": "上下文达 200,000 个 token 后的空闲压缩策略。",
              "en-US": "When to compact an idle conversation with at least 200,000 tokens."
            },
            "options": [
              {
                "value": "default",
                "label": {
                  "zh-CN": "使用默认设置",
                  "en-US": "Use default"
                }
              },
              {
                "value": "onReturn",
                "label": {
                  "zh-CN": "返回会话时",
                  "en-US": "When you return"
                }
              },
              {
                "value": "beforeCacheExpires",
                "label": {
                  "zh-CN": "在缓存过期前（Beta）",
                  "en-US": "Before the cache expires (beta)"
                }
              },
              {
                "value": "off",
                "label": {
                  "zh-CN": "从不",
                  "en-US": "Never"
                }
              }
            ],
            "default": "default"
          },
          {
            "key": "launchArgs",
            "type": "text",
            "monospace": true,
            "label": {
              "zh-CN": "启动参数",
              "en-US": "Launch arguments"
            },
            "placeholder": "--chrome",
            "description": {
              "zh-CN": "追加给 Claude Code 的长选项；权限相关的选项由 Pigcode 的权限模式管理。",
              "en-US": "Extra long flags for Claude Code; permission flags follow Pigcode's permission mode."
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            },
            "description": {
              "zh-CN": "启动 Claude Code 时额外设置的环境变量，例如代理或 API 地址。",
              "en-US": "Extra environment variables for the Claude Code process, such as a proxy or API base URL."
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "json5": "2.2.3",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
