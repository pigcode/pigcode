{
  "name": "@pigcode/agent-opencode",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "OpenCode",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:opencode"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "opencode",
        "featured": true,
        "acpRegistryAgentIds": [
          "opencode",
          "opencode-v2"
        ],
        "homepage": "https://opencode.ai/docs/server/",
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "label": {
              "zh-CN": "可执行文件",
              "en-US": "Binary path"
            },
            "pathKind": "file",
            "placeholder": "opencode"
          },
          {
            "key": "serverUrl",
            "type": "text",
            "label": {
              "zh-CN": "服务器地址",
              "en-US": "Server URL"
            },
            "placeholder": "http://127.0.0.1:4096"
          },
          {
            "key": "serverPassword",
            "type": "secret",
            "label": {
              "zh-CN": "服务器密码",
              "en-US": "Server password"
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            }
          }
        ],
        "requiresInstance": true
      }
    }
  },
  "dependencies": {
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*",
    "@pigcode/native-agent-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
