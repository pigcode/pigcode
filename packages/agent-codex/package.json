{
  "name": "@pigcode/agent-codex",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Codex agent for Pigcode",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "pigcode": ">=0.1.0-0"
  },
  "pigcode": {
    "apiVersion": 1,
    "kind": "agent",
    "displayName": "Codex",
    "host": "./src/index.ts",
    "inject": [
      "agents"
    ],
    "provides": [
      "agent:codex"
    ],
    "permissions": [
      "process:spawn",
      "fs:workspace",
      "network"
    ],
    "contributes": {
      "agent": {
        "id": "codex",
        "featured": true,
        "acpRegistryAgentIds": [
          "codex-acp"
        ],
        "description": {
          "zh-CN": "OpenAI 的编程 Agent，能写计划，也能接着上次的会话继续",
          "en-US": "OpenAI's coding agent. It can plan and pick up past threads"
        },
        "homepage": "https://developers.openai.com/codex/cli",
        "installHint": {
          "zh-CN": "先安装 Codex（npm i -g @openai/codex），再运行 codex login 登录",
          "en-US": "Install Codex (npm i -g @openai/codex), then run codex login"
        },
        "settings": [
          {
            "key": "binaryPath",
            "type": "path",
            "pathKind": "file",
            "label": {
              "zh-CN": "程序位置",
              "en-US": "Program path"
            },
            "placeholder": "codex",
            "description": {
              "zh-CN": "不填就自动找 codex",
              "en-US": "Leave empty to find codex automatically"
            }
          },
          {
            "key": "homePath",
            "type": "path",
            "pathKind": "directory",
            "label": {
              "zh-CN": "配置文件夹",
              "en-US": "Config folder"
            },
            "placeholder": "~/.codex",
            "description": {
              "zh-CN": "Codex 放设置和登录信息的地方（CODEX_HOME）。不填就用默认位置。",
              "en-US": "Where Codex keeps its settings and sign-in (CODEX_HOME). Leave empty for the default."
            }
          },
          {
            "key": "shadowHomePath",
            "type": "path",
            "pathKind": "directory",
            "label": {
              "zh-CN": "单独的账号文件夹",
              "en-US": "Separate account folder"
            },
            "placeholder": "~/.codex-pigcode/work",
            "description": {
              "zh-CN": "这个账号的登录信息单独放，设置和会话还用 CODEX_HOME 里的",
              "en-US": "Keeps this account's sign-in on its own. Settings and threads still come from CODEX_HOME."
            }
          },
          {
            "key": "launchArgs",
            "type": "text",
            "monospace": true,
            "label": {
              "zh-CN": "启动参数",
              "en-US": "Launch arguments"
            },
            "placeholder": "-c model_reasoning_summary=detailed",
            "description": {
              "zh-CN": "加在 codex app-server 后面的参数",
              "en-US": "Extra arguments after codex app-server"
            }
          },
          {
            "key": "environment",
            "type": "env",
            "label": {
              "zh-CN": "环境变量",
              "en-US": "Environment variables"
            },
            "description": {
              "zh-CN": "启动 Codex 时加的环境变量，比如代理或 API 密钥",
              "en-US": "Extra environment variables for Codex, like a proxy or API key"
            }
          },
          {
            "key": "setupMode",
            "type": "select",
            "visibility": "hidden",
            "label": {
              "zh-CN": "账号",
              "en-US": "Account"
            },
            "options": [
              {
                "value": "existing",
                "label": {
                  "zh-CN": "用电脑上装好的 Codex",
                  "en-US": "Use Codex on this computer"
                }
              },
              {
                "value": "managed",
                "label": "ChatGPT"
              }
            ],
            "default": "existing"
          }
        ]
      }
    }
  },
  "dependencies": {
    "@pigcode/contracts": "workspace:*",
    "@pigcode/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
